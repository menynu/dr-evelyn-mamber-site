---
import { getCopy } from "../content";
import { phonePattern } from "../lib/phone.js";
import { absoluteUrl, localePath } from "../lib/paths";
import UrgentNotice from "./UrgentNotice.astro";

const t = getCopy("he");
// After the first real submission, FormSubmit emails an activation link.
// Once that is confirmed, replace the address below with the random alias
// FormSubmit provides, so the mailbox is not exposed in the HTML.
const formAction = "https://formsubmit.co/meny205@gmail.com";
const subject = "בקשה לשיחה חוזרת – אתר ממבר";
const nextUrl = absoluteUrl("/contact/thanks/");
const privacyHref = localePath("he", "/privacy/");
const phoneError = "הקלידו מספר טלפון ישראלי.";
const parentError = "מלאו את שם ההורה.";
const ageError = "בחרו את גיל הילד/ה.";
const timeError = "בחרו זמן נוח.";
const consentError = "כדי לשלוח צריך לאשר את שורת ההסכמה.";
const medicalNote = "אין צורך לפרט כאן מידע רפואי. נדבר על הכול בטלפון.";
const times = ["בוקר", "צהריים", "אחה״צ"];
---
<div class="callback-block">
  <UrgentNotice />
  <form
    class="form callback-form"
    id="callback-form"
    action={formAction}
    method="post"
    accept-charset="UTF-8"
    data-callback-form
    data-phone-error={phoneError}
    data-parent-error={parentError}
    data-age-error={ageError}
    data-time-error={timeError}
    data-consent-error={consentError}
    data-required-error={t.contact.error}
    aria-labelledby="callback-title"
    aria-describedby="callback-medical-note"
  >
    <input type="hidden" name="_subject" value={subject} />
    <input type="hidden" name="_template" value="table" />
    <input type="hidden" name="_captcha" value="true" />
    <input type="hidden" name="_next" value={nextUrl} />

    <h2 id="callback-title">{t.contact.formTitle}</h2>

    <label class="field">
      <span>{t.contact.parentLabel} ({t.required})</span>
      <input
        id="callback-parent"
        name="שם הורה"
        type="text"
        autocomplete="name"
        maxlength="80"
        required
        aria-describedby="callback-parent-error"
      />
      <span class="field-error" id="callback-parent-error" role="alert" hidden></span>
    </label>

    <label class="field">
      <span>{t.contact.phoneField} ({t.required})</span>
      <input
        id="callback-phone"
        name="טלפון"
        type="tel"
        inputmode="tel"
        dir="ltr"
        autocomplete="tel"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        maxlength="22"
        pattern={phonePattern}
        aria-describedby="callback-phone-hint callback-phone-error"
        required
      />
      <span class="hint" id="callback-phone-hint">
        מספר ישראלי, למשל <span class="ltr">050-1234567</span> או <span class="ltr">02-1234567</span>.
      </span>
      <span class="field-error" id="callback-phone-error" role="alert" hidden></span>
    </label>

    <label class="field">
      <span>{t.contact.ageLabel} ({t.required})</span>
      <select id="callback-age" name="גיל הילד/ה" required aria-describedby="callback-age-error">
        <option value="">{t.contact.agePlaceholder}</option>
        {t.contact.ages.map((age) => <option value={age}>{age}</option>)}
      </select>
      <span class="field-error" id="callback-age-error" role="alert" hidden></span>
    </label>

    <label class="field">
      <span>{t.contact.timeLabel} ({t.required})</span>
      <select id="callback-time" name="זמן נוח לשיחה" required aria-describedby="callback-time-error">
        <option value="">{t.contact.timePlaceholder}</option>
        {times.map((time) => <option value={time}>{time}</option>)}
      </select>
      <span class="field-error" id="callback-time-error" role="alert" hidden></span>
    </label>

    <p class="hint" id="callback-medical-note">{medicalNote}</p>

    <div class="check">
      <input
        id="callback-consent"
        name="הסכמה"
        type="checkbox"
        value={t.contact.consent}
        required
        aria-describedby="callback-consent-error"
      />
      <label for="callback-consent">{t.contact.consent}</label>
    </div>
    <span class="field-error" id="callback-consent-error" role="alert" hidden></span>
    <p class="hint">
      <a class="consent-link" href={privacyHref}>מדיניות הפרטיות</a>
    </p>

    <p class="form-error" id="callback-error" data-form-error role="alert" hidden></p>
    <div class="honeypot" aria-hidden="true">
      <label>
        השאירו את השדה הזה ריק
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" value="" />
      </label>
    </div>
    <button class="btn btn-primary" type="submit">{t.contact.submit}</button>
  </form>
</div>

<script>
  import { isIsraeliPhone } from "../lib/phone.js";

  const form = document.querySelector("[data-callback-form]");
  if (form instanceof HTMLFormElement) {
    const phone = form.querySelector("#callback-phone");
    const parent = form.querySelector("#callback-parent");
    const age = form.querySelector("#callback-age");
    const time = form.querySelector("#callback-time");
    const consent = form.querySelector("#callback-consent");
    const sharedError = form.querySelector("[data-form-error]");

    const messages = {
      phone: form.dataset.phoneError || "",
      parent: form.dataset.parentError || "",
      age: form.dataset.ageError || "",
      time: form.dataset.timeError || "",
      consent: form.dataset.consentError || "",
    };

    const fieldError = (field: Element | null) => {
      if (!(field instanceof HTMLElement)) return null;
      const id = field.getAttribute("aria-describedby")?.split(/\s+/).find((token) => token.endsWith("-error"));
      if (!id) return null;
      const node = form.querySelector(`#${CSS.escape(id)}`);
      return node instanceof HTMLElement ? node : null;
    };

    const hideShared = () => {
      if (!(sharedError instanceof HTMLElement)) return;
      sharedError.hidden = true;
      sharedError.textContent = "";
    };

    const showFieldError = (field: HTMLInputElement | HTMLSelectElement, message: string) => {
      const box = fieldError(field);
      if (box) {
        box.hidden = false;
        box.textContent = message;
      }
      field.setAttribute("aria-invalid", "true");
      field.setCustomValidity(message);
      hideShared();
    };

    const clearFieldError = (field: HTMLInputElement | HTMLSelectElement) => {
      const box = fieldError(field);
      if (box) {
        box.hidden = true;
        box.textContent = "";
      }
      field.removeAttribute("aria-invalid");
      field.setCustomValidity("");
    };

    const phoneOk = () => {
      if (!(phone instanceof HTMLInputElement)) return true;
      const value = phone.value.trim();
      if (value === "") return false;
      return isIsraeliPhone(value);
    };

    const syncPhone = () => {
      if (!(phone instanceof HTMLInputElement)) return true;
      const value = phone.value.trim();
      if (value !== "" && !isIsraeliPhone(value)) {
        showFieldError(phone, messages.phone);
        return false;
      }
      if (value !== "") clearFieldError(phone);
      else {
        const box = fieldError(phone);
        if (box) {
          box.hidden = true;
          box.textContent = "";
        }
        phone.removeAttribute("aria-invalid");
        phone.setCustomValidity("");
      }
      return true;
    };

    const validateField = (field: HTMLInputElement | HTMLSelectElement) => {
      if (field === phone) {
        if (!(phone instanceof HTMLInputElement)) return true;
        if (!phone.value.trim()) {
          showFieldError(phone, messages.phone);
          return false;
        }
        if (!isIsraeliPhone(phone.value)) {
          showFieldError(phone, messages.phone);
          return false;
        }
        clearFieldError(phone);
        return true;
      }
      if (field === parent) {
        if (!(parent instanceof HTMLInputElement)) return true;
        if (!parent.value.trim()) {
          showFieldError(parent, messages.parent);
          return false;
        }
        clearFieldError(parent);
        return true;
      }
      if (field === age) {
        if (!(age instanceof HTMLSelectElement)) return true;
        if (!age.value) {
          showFieldError(age, messages.age);
          return false;
        }
        clearFieldError(age);
        return true;
      }
      if (field === time) {
        if (!(time instanceof HTMLSelectElement)) return true;
        if (!time.value) {
          showFieldError(time, messages.time);
          return false;
        }
        clearFieldError(time);
        return true;
      }
      if (field === consent) {
        if (!(consent instanceof HTMLInputElement)) return true;
        if (!consent.checked) {
          showFieldError(consent, messages.consent);
          return false;
        }
        clearFieldError(consent);
        return true;
      }
      return true;
    };

    form.addEventListener(
      "invalid",
      (event) => {
        event.preventDefault();
        const field = event.target;
        if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement)) return;
        validateField(field);
      },
      true,
    );

    if (phone instanceof HTMLInputElement) {
      phone.addEventListener("input", () => {
        syncPhone();
      });
    }

    form.addEventListener("input", (event) => {
      const field = event.target;
      if (field === phone) return;
      if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) {
        if (field.validity.valid || (field instanceof HTMLInputElement && field.type !== "checkbox" && field.value.trim())) {
          clearFieldError(field);
        }
      }
    });

    form.addEventListener("change", (event) => {
      const field = event.target;
      if (field instanceof HTMLSelectElement || (field instanceof HTMLInputElement && field.type === "checkbox")) {
        validateField(field);
        if (field instanceof HTMLInputElement && field.type === "checkbox" && field.checked) clearFieldError(field);
        if (field instanceof HTMLSelectElement && field.value) clearFieldError(field);
      }
    });

    form.addEventListener("submit", (event) => {
      const fields = [parent, phone, age, time, consent].filter(
        (node): node is HTMLInputElement | HTMLSelectElement =>
          node instanceof HTMLInputElement || node instanceof HTMLSelectElement,
      );
      let firstInvalid: HTMLInputElement | HTMLSelectElement | null = null;
      for (const field of fields) {
        const ok = validateField(field);
        if (!ok && !firstInvalid) firstInvalid = field;
      }
      if (firstInvalid) {
        event.preventDefault();
        firstInvalid.focus();
        return;
      }
      if (!phoneOk()) {
        event.preventDefault();
        if (phone instanceof HTMLInputElement) {
          showFieldError(phone, messages.phone);
          phone.focus();
        }
      }
    });
  }
</script>
