---
interface Props {
  name: string;
}
const { name } = Astro.props;
const common = {
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "1.8",
  "stroke-linecap": "round" as const,
  "stroke-linejoin": "round" as const,
  "aria-hidden": true,
};
---
{name === "tooth" && (
  <svg {...common}><path d="M8 4.5c2 0 2.4 2 4 2s2-2 4-2c2.6 0 4 2.2 4 5.2 0 3.2-1.2 5.2-2.2 8.1-.6 1.8-1.4 2.7-2.6 2.7-1.2 0-1.6-1.2-2.2-2.6-.4-.9-1-.9-1.4 0-.6 1.4-1 2.6-2.2 2.6-1.2 0-2-1-2.6-2.7C5.2 14.9 4 12.9 4 9.7 4 6.7 5.4 4.5 8 4.5Z"/></svg>
)}
{name === "spark" && (
  <svg {...common}><path d="M12 3.5 13.4 9 19 10.5 13.4 12 12 17.5 10.6 12 5 10.5 10.6 9 12 3.5Z"/><path d="M18 15.5 18.6 17.4 20.5 18 18.6 18.6 18 20.5 17.4 18.6 15.5 18 17.4 17.4 18 15.5Z"/></svg>
)}
{name === "shield" && (
  <svg {...common}><path d="M12 3.5 19 6.2v5.2c0 4.2-2.8 6.8-7 8.6-4.2-1.8-7-4.4-7-8.6V6.2L12 3.5Z"/><path d="m9 11.5 2 2 4-4"/></svg>
)}
{name === "drop" && (
  <svg {...common}><path d="M12 3.5s5 5.2 5 9a5 5 0 0 1-10 0c0-3.8 5-9 5-9Z"/></svg>
)}
{name === "heart" && (
  <svg {...common}><path d="M12 19s-6.5-3.8-6.5-8.2A3.4 3.4 0 0 1 12 8.2a3.4 3.4 0 0 1 6.5 2.6C18.5 15.2 12 19 12 19Z"/></svg>
)}
{name === "book" && (
  <svg {...common}><path d="M5 5.5A2.5 2.5 0 0 1 7.5 3H19v16H7.5A2.5 2.5 0 0 0 5 21.5V5.5Z"/><path d="M5 19.2A2.5 2.5 0 0 1 7.5 17H19"/></svg>
)}
{name === "calendar" && (
  <svg {...common}><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3.5v3M16 3.5v3M4 10h16"/></svg>
)}
{name === "phone" && (
  <svg {...common}><path d="M8 4.5h2.2l1.2 3-1.6 1a12 12 0 0 0 5.7 5.7l1-1.6 3 1.2V18a1.5 1.5 0 0 1-1.6 1.5A14.5 14.5 0 0 1 4.5 6.1 1.5 1.5 0 0 1 6 4.5H8Z"/></svg>
)}
{name === "pin" && (
  <svg {...common}><path d="M12 21s6-5.4 6-10a6 6 0 1 0-12 0c0 4.6 6 10 6 10Z"/><circle cx="12" cy="11" r="1.6"/></svg>
)}
{name === "clock" && (
  <svg {...common}><circle cx="12" cy="12" r="8"/><path d="M12 8v4.5L15 15"/></svg>
)}
{name === "chat" && (
  <svg {...common}><path d="M6 16.5 4 20l3.8-1.2A8.5 8.5 0 1 0 6 16.5Z"/></svg>
)}
{name === "leaf" && (
  <svg {...common}><path d="M5 19s.5-6 4-9 10-4 10-4-1 6.5-4 10-10 3-10 3Z"/><path d="M9 15c1.5-1.5 3-3 4.5-5.5"/></svg>
)}
{name === "users" && (
  <svg {...common}><circle cx="9" cy="9" r="2.4"/><circle cx="16" cy="10" r="2"/><path d="M4.8 17.5c.6-2 2.3-3 4.2-3s3.6 1 4.2 3"/><path d="M13.2 14.6c1.4-.3 2.8.1 3.6 1.4.6 1 .9 1.6.9 1.6"/></svg>
)}
{name === "close" && (
  <svg {...common}><path d="M6 6l12 12M18 6 6 18"/></svg>
)}
{name === "chevron" && (
  <svg {...common} class="chevron"><path d="m6 9 6 6 6-6"/></svg>
)}
{name === "arrow" && (
  <svg {...common} class="arrow"><path d="M15 6 9 12l6 6"/></svg>
)}
