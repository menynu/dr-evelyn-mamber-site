---
import Breadcrumb from "../components/Breadcrumb.astro";
import CallbackForm from "../components/CallbackForm.astro";
import NavActions from "../components/NavActions.astro";
import ReviewCta from "../components/ReviewCta.astro";
import UrgentNotice from "../components/UrgentNotice.astro";
import { getCopy } from "../content";
import { clinic } from "../lib/config";
import { localePath } from "../lib/paths";
import { accessText, addressLine, addressStatus, fundsText, hoursText, mapsEmbedSrc, mapsHref, whatsappHref } from "../lib/public";
import type { Locale } from "../lib/role";
import Base from "../layouts/Base.astro";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getCopy(locale);
const crumbs = [
  { name: t.homeLabel, path: "/" },
  { name: t.nav.find((item) => item.id === "contact")?.label || "", path: "/contact/" },
];
const wa = whatsappHref();
const privacyHref = localePath(locale, "/privacy/");
---
<Base locale={locale} title={t.meta.contact.title} description={t.meta.contact.description} path="/contact/" kind="contact" breadcrumbs={crumbs}>
  <div class="container page-intro">
    <Breadcrumb locale={locale} items={crumbs} />
    <p class="kicker">{t.contact.kicker}</p>
    <h1>{t.contact.title}</h1>
    <p class="lede">{t.contact.lede}</p>
  </div>
  <section class="section">
    <div class="container split">
      {locale === "he" ? (
        <CallbackForm />
      ) : (
        <div class="callback-block">
          <UrgentNotice locale={locale} />
          <form
            class="form"
            method="dialog"
            data-booking-form
            data-template={t.contact.template}
            data-whatsapp={wa}
            data-tel={clinic.phoneTel}
            data-error={t.contact.error}
          >
            <h2>{t.contact.formTitle}</h2>
            <label class="field">
              <span>{t.contact.parentLabel} ({t.required})</span>
              <input name="parent" type="text" autocomplete="name" maxlength="80" required />
            </label>
            <label class="field">
              <span>{t.contact.phoneField} ({t.required})</span>
              <input name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="20" required />
            </label>
            <label class="field">
              <span>{t.contact.ageLabel} ({t.required})</span>
              <select name="age" required>
                <option value="">{t.contact.agePlaceholder}</option>
                {t.contact.ages.map((age) => <option value={age}>{age}</option>)}
              </select>
            </label>
            <label class="field">
              <span>{t.contact.timeLabel} ({t.required})</span>
              <input name="time" type="text" maxlength="80" required placeholder={t.contact.timePlaceholder} aria-describedby="time-hint" />
              <span class="hint" id="time-hint">{t.contact.timeHint}</span>
            </label>
            <label class="check">
              <input name="consent" type="checkbox" required />
              <span>{t.contact.consent}</span>
            </label>
            <p class="hint">
              This opens WhatsApp with your details already written. Nothing is sent until you press send in WhatsApp. The message goes through WhatsApp, a service run by Meta, to the clinic's number, and is used only to arrange an appointment. You are not legally required to provide these details, but without them we cannot get back to you. Please don't add medical details. You can also just call <span class="ltr">{clinic.phoneDisplay}</span>, and you can call the same number to see or correct your details.
              {" "}
              <a class="consent-link" href={privacyHref}>Privacy policy</a>
            </p>
            <p class="form-error" data-form-error hidden></p>
            <button class="btn btn-primary" type="submit">{wa ? t.contact.submit : t.call}</button>
            {clinic.email && (
              <button
                class="btn btn-secondary"
                type="button"
                data-email-button
                data-email={clinic.email}
                data-subject={t.contact.emailSubject}
              >
                {t.contact.emailSubmit}
              </button>
            )}
            <noscript>
              <p>
                <a href={`tel:${clinic.phoneTel}`}>{clinic.phoneDisplay}</a>
                {wa && <> · <a href={whatsappHref(t.contact.genericWhatsapp)}>{t.whatsapp}</a></>}
              </p>
            </noscript>
          </form>
        </div>
      )}
      <div class="stack">
        <div class="card detail-list">
          <h2>{t.contact.phoneLabel}</h2>
          <p><a class="ltr" href={`tel:${clinic.phoneTel}`}>{clinic.phoneDisplay}</a></p>
          <h2>{t.contact.addressLabel}</h2>
          <p>{addressLine(locale)}</p>
          {addressStatus(locale) && <p class="hint">{addressStatus(locale)}</p>}
          <p class="hint">{t.contact.addressHint}</p>
          <h2>{t.contact.hoursLabel}</h2>
          {clinic.hoursConfirmed ? (
            <ul>
              {clinic.hours.map((row) => (
                <li>
                  {locale === "he" ? row.daysHe : row.daysEn}: {row.closed ? (locale === "he" ? "סגור" : "closed") : `${row.open}–${row.close}`}
                </li>
              ))}
            </ul>
          ) : (
            <p>{hoursText(locale)}</p>
          )}
          <h2>{t.contact.fundsLabel}</h2>
          <p>{fundsText(locale)}</p>
          <h2>{t.contact.accessLabel}</h2>
          <p>{accessText(locale)}</p>
        </div>
        <div class="map-panel" data-map-slot>
          <NavActions locale={locale} />
          <button
            class="btn btn-secondary"
            type="button"
            data-map-button
            data-map-src={mapsEmbedSrc()}
            data-map-title={t.contact.mapTitle}
          >
            {t.contact.mapButton}
          </button>
          <p class="hint">{t.contact.mapNote}</p>
          <a href={mapsHref()} target="_blank" rel="noopener noreferrer">
            {t.contact.mapOpen}
            <span class="sr-only">{t.newTab}</span>
          </a>
        </div>
        <aside class="card review-panel">
          <ReviewCta locale={locale} titleId="contact-review-title" />
        </aside>
        <aside class="urgent">
          <h2>{t.emergencyTitle}</h2>
          <p>{t.emergencyBody}</p>
        </aside>
      </div>
    </div>
  </section>
</Base>
